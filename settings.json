{
  /*
  *****************************************************************************************
  Hello, World!

  This is the settings.json file of stefanlachmann <2lach>
  this setup is mainly used on for my macbook(s) and sometimes Linux

  Links and sources
  - [settings.json](https://code.visualstudio.com/docs/getstarted/settings#_default-settings)
  - [colors](https://code.visualstudio.com/api/references/theme-color)

  *****************************************************************************************
  */
  "editor.fontFamily": "'FiraCode Nerd Font Mono', 'RobotoMono Nerd Font Mono', 'JetBrains mono nerdfont', 'Space Mono for Powerline', 'GoMono Nerd Font Mono', 'Courier New', monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 12,
  "editor.lineHeight": 26,
  "editor.acceptSuggestionOnEnter": "on",
  "editor.accessibilitySupport": "off",
  "editor.cursorStyle": "line",
  "editor.cursorSurroundingLines": 0,
  "editor.find.cursorMoveOnType": true,
    "editor.codeLens": true,
  "editor.autoClosingBrackets": "languageDefined",
  "editor.minimap.enabled": true,
  "editor.detectIndentation": true,
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  // formats only modified lines
  "editor.formatOnSaveMode": "modifications",
  "editor.cursorBlinking": "solid",
  "editor.cursorWidth": 2,
  "editor.cursorSurroundingLinesStyle": "default",
  "editor.wordWrap": "on",
  "editor.suggestFontSize": 14,
  "editor.suggestLineHeight": 15,
  "editor.suggest.preview": true,
  "editor.renderWhitespace": "trailing", // shows whitespace
  "editor.suggestSelection": "first",
  // actions on save
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.fixAll.tslint": "explicit",
    "source.fixAll.stylelint": "explicit",
    "source.fixAll.markdownlint": "explicit"
  },
  "editor.tabSize": 2,
  "editor.bracketPairColorization.enabled": true,
  "search.exclude": {
    "**/node_modules": true,
    "**/*.code-search": true,
    "ios/": true,
    "android/": true,
    "dist/": true,
    "build/": true,
    "package-lock.json": true,
    ".gitignore": true,
    ".expo": true,
    ".vscode": true
  },
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmDelete": true,
  "scm.diffDecorationsGutterAction": "diff",
  "workbench.editor.enablePreview": false,
  "workbench.sideBar.location": "left",
  "workbench.iconTheme": "vscode-icons",
  "workbench.fontAliasing": "auto",
  "workbench.tree.renderIndentGuides": "always",
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.settings.editor": "json",
  "workbench.editor.tabSizing": "shrink",
  "workbench.colorTheme": "Default Dark+",
  "workbench.startupEditor": "welcomePageInEmptyWorkbench",
  //* Custom VS Workbench colors
  "workbench.colorCustomizations": {
    "activityBarBadge.background": "#2979FF",
    "breadcrumb.activeSelectionForeground": "#2979FF",
    "breadcrumb.focusForeground": "#2979FF",
    "editorSuggestWidget.highlightForeground": "#2979FF",
    "editorWidget.border": "#2979FF",
    "editorWidget.resizeBorder": "#2979FF",
    "errorLens.enabled": true,
    "errorLens.errorBackground": "#efebeb00",
    "errorLens.hintBackground": "#fff0",
    "errorLens.hintMessageBackground": "#fff0",
    "errorLens.infoBackground": "#fff0",
    "errorLens.warningMessageBackground": "#fff0",
    "gitlens.gutterBackgroundColor": "#ff0000",
    "list.activeSelectionBackground": "#2979FF",
    "list.activeSelectionForeground": "#e8fbde",
    // "list.filterMatchBorder": "#ff0000",
    "list.inactiveSelectionForeground": "#2979FF",
    "menu.selectionForeground": "#2979FF",
    "menubar.selectionForeground": "#2979FF",
    "notificationLink.foreground": "#2979FF",
    "panelTitle.activeBorder": "#2979FF",
    "pickerGroup.foreground": "#2979FF",
    "scrollbarSlider.activeBackground": "#2979FF50",
    "settings.headerForeground": "#2979FF",
    "settings.modifiedItemForeground": "#2979FF",
    "settings.modifiedItemIndicator": "#2979FF",
    "statusBar.background": "#b0d6b0",
    "statusBar.debuggingBackground": "#b0d6b0",
    "statusBar.debuggingForeground": "#434C5E",
    "statusBar.foreground": "#434C5E",
    "statusBar.noFolderBackground": "#b0d6b0",
    "tab.activeBorder": "#2979FF",
    "textLink.foreground": "#2979FF",
    "editorWhitespace.foreground": "#7a8394"
  },
  "files.autoSave": "onFocusChange", // all, error, crash, off
  // integrated terminal
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font Mono', 'FiraCode Nerd Font', 'JetBrains Mono', 'MesloLGS NF','JuliaMono'",
  "terminal.integrated.fontSize": 18,
  "terminal.integrated.cursorStyle": "underline",
  "terminal.integrated.fontWeight": "400",
  "terminal.integrated.cursorWidth": 3,
  "terminal.integrated.inheritEnv": true,
  "terminal.integrated.confirmOnExit": "never",
  "extensions.closeExtensionDetailsOnViewChange": true,
  "eslint.codeAction.showDocumentation": {
    "enable": true,
  },
  "eslint.debug": true,
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "eslint.enable": true,
  "eslint.codeActionsOnSave.mode": "problems",
  "eslint.lintTask.enable": true,
  "eslint.run": "onSave",
  //"sync.gist": "93421b16be15fd8697e90d64b35da544", // MacBook Work 
  // Formatting
  //* Prettier
  "prettier.singleQuote": true,
  "prettier.jsxSingleQuote": true,
  "prettier.trailingComma": "none",
  "prettier.arrowParens": "avoid",
  "prettier.proseWrap": "preserve",
  "prettier.quoteProps": "as-needed",
  "prettier.bracketSameLine": false,
  "prettier.bracketSpacing": true,
  "prettier.tabWidth": 2,
  //* Markdown
  "markdown.preview.doubleClickToSwitchToEditor": true,
  //"markdown.preview.fontFamily": "Monaco, -apple-system, BlinkMacSystemFont, 'Segoe WPC', 'Segoe UI', system-ui, 'Ubuntu', 'Droid Sans', sans-serif",
  "markdown.preview.breaks": false,
  "markdown.preview.fontSize": 15,
  "markdown.preview.lineHeight": 1.8,
  "[markdown]": {
    "editor.autoIndent": "advanced",
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  //* JSON
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.formatOnSave": true
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  //* JavaScript
  "javascript.autoClosingTags": true,
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },
  //* JavaScript, React.js
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[ruby]": {
    "editor.formatOnSave": true, 
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.semanticHighlighting.enabled": true, // Enable semantic highlighting
    "editor.formatOnSaveMode": "file"
  },
  "rubyLsp.rubyVersionManager": "rbenv",
  "rubyLsp.formatter": "auto",
  //* TypeScript
  "typescript.autoClosingTags": true,
  "typescript.inlayHints.parameterNames.enabled": "all",
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  //* terraform
  "[terraform]": {
    "editor.defaultFormatter": "hashicorp.terraform"
  },
  //* TypeScript + React
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  //* Python
  "[python]": {
    "editor.defaultFormatter": "ms-python.python",
    "editor.formatOnSave": true,
  },
  //* Html
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features"
  },
  "html.format.contentUnformatted": "pre,code,textarea",
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "javascript.updateImportsOnFileMove.enabled": "always",
  // settings sync -> using builtin

  // Gitlens 
  "gitlens.codeLens.authors.enabled": true,
  "gitlens.hovers.currentLine.details": true,
  "gitlens.codeLens.includeSingleLineSymbols": true,
  "gitlens.currentLine.format": "${author, }${date}${' via 'pullRequest}${ • message|50?}",
  "gitlens.showWelcomeOnInstall": false,
  "gitlens.defaultGravatarsStyle": "identicon",
  // Shellcheck
  "shellcheck.enable": true,
  "shellcheck.enableQuickFix": true, // beta feature
  "shellcheck.run": "onType",
  "shellcheck.ignoreFileSchemes": [
    "git",
    "gitfs"
  ],
  "shellcheck.exclude": [],
  "shellcheck.customArgs": [],
  "shellcheck.ignorePatterns": {
    "**/*.zsh": true,
    "**/*.zsh*": true,
    "**/.git/*.sh": true,
    "**/folder/**/*.sh": true
  },
  // Python 
  "python.diagnostics.sourceMapsEnabled": true,
  "python.languageServer": "Default", // "Jedi"
  // Error Lens
  "errorLens.messageTemplate": "$message $count",
  "errorLens.gutterIconsEnabled": true,
  "errorLens.enabledDiagnosticLevels": [
    "error",
    "warning",
    "info"
    //, "hint" 
  ],
  "errorLens.onSave": true,
  "errorLens.exclude": [
    "never (read|used)"
  ],
  "window.restoreFullscreen": true,
  "window.title": "${activeEditorShort}${separator}${rootName}",
  "emmet.triggerExpansionOnTab": true,
  "npm-intellisense.importES6": true,
  "security.workspace.trust.untrustedFiles": "open",
  "debug.javascript.autoAttachFilter": "smart",
  "editor.inlineSuggest.enabled": true,
  "update.mode": "start",
  // Azure AppService Debug
  "appService.enableOutputTimestamps": true,
  "redhat.telemetry.enabled": false,
  // golang
  "go.useLanguageServer": true,
  "go.toolsManagement.autoUpdate": true,
  "gopls": {
    "ui.semanticTokens": true
  },
  "peacock.favoriteColors": [
    {
      "name": "Angular Red",
      "value": "#dd0531"
    },
    {
      "name": "Azure Blue",
      "value": "#007fff"
    },
    {
      "name": "JavaScript Yellow",
      "value": "#f9e64f"
    },
    {
      "name": "Mandalorian Blue",
      "value": "#1857a4"
    },
    {
      "name": "Node Green",
      "value": "#215732"
    },
    {
      "name": "React Blue",
      "value": "#61dafb"
    },
    {
      "name": "Something Different",
      "value": "#832561"
    },
    {
      "name": "Svelte Orange",
      "value": "#ff3d00"
    },
    {
      "name": "Vue Green",
      "value": "#42b883"
    }
  ],
  "git.openRepositoryInParentFolders": "always",
  "[css]": {
     "editor.defaultFormatter": "vscode.css-language-features"
   },
  "[azure-pipelines]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true
    },
    "editor.autoIndent": "full"
  },
  //* Android iOS Emulator
  "emulator.emulatorPathMac": "~/Library/Android/sdk/emulator",
  "emulator.androidColdBoot": true,

  //* VsCodeVim start
  "vim.cursorStylePerMode.insert": "line",
  "vim.cursorStylePerMode.normal": "block-outline",
  "vim.cursorStylePerMode.replace": "block-outline",
  "vim.cursorStylePerMode.visual": "block",
  "vim.easymotionDimBackground": false,
  "vim.highlightedyank.enable": true,
  "vim.vimrc.path": "$HOME/.config/nvim/init.vim",
  "vim.leader": ",",
  "vim.enableNeovim": true,
  "vim.overrideCopy": false,
  "vim.hlsearch": true,
  "vim.statusBarColorControl": true,
  "vim.statusBarColors.normal": [
    "#b0d6b0",
    "#434C5E"
  ],
  "vim.statusBarColors.insert": "#6188ad",
  "vim.statusBarColors.visual": "#dib0d6",
  "vim.statusBarColors.visualline": "#d6b0d6",
  "vim.statusBarColors.visualblock": "#d6b0d6",
  "vim.statusBarColors.replace": "#ae6060",
  "vim.statusBarColors.commandlineinprogress": "#ebebeb",
  "vim.statusBarColors.surroundinputmode": "#007ACC",
  "vim.incsearch": false,
  "vim.debug.loggingLevelForConsole": "warn",
  "vim.useSystemClipboard": true,
  //* VsCodeVim End

  "files.associations": {
    "config": "editorconfig",
    "*.css": "css",
    "*.cshtml": "aspnetcorerazor"
  },
  "vsicons.dontShowNewVersionMessage": true,
  "github.copilot.enable": {
    "javascript": "true"
  },
  "github.copilot.advanced": {
    
  },
"diffEditor.ignoreTrimWhitespace": false,
"[csharp]": {
  "breadcrumbs.showInterfaces": true,
  "editor.maxTokenizationLineLength": 2500,
  "editor.inlineSuggest.suppressSuggestions": false
},
"sqlDatabaseProjects.netCoreDoNotAsk": true,
"omnisharp.dotNetCliPaths": [
  "/usr/local/share/dotnet/dotnet"
],
"dotnet.server.useOmnisharp": true,
"git.suggestSmartCommit": false,
"diffEditor.hideUnchangedRegions.enabled": true,
"dotnet.help.firstView": "auto",
"extensions.confirmedUriHandlerExtensionIds": [
    "ms-dotnettools.dotnet-interactive-vscode",
    "ms-dotnettools.vscode-dotnet-pack"
],
"telemetry.telemetryLevel": "crash",
"dotnetAcquisitionExtension.enableTelemetry": false,
"gitlens.telemetry.enabled": false,
"bashIde.explainshellEndpoint": "http://localhost:5001",
"[aspnetcorerazor]": {
  "editor.defaultFormatter": "ms-dotnettools.csharp"
},

"editor.unicodeHighlight.invisibleCharacters": false
}